# NVIDIA_API_KEY: Required for NVIDIA NIM AI API calls (Moonshot AI Kimi K3.1 Pro).
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
NVIDIA_KEY_ID="af669c02-33b0-4149-a0d9-2a89860715e7"
NVIDIA_MODEL="moonshotai/kimi-k3.1-pro"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# GEMINI_API_KEY: Optional secondary AI fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
