rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'iagoofss@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- VALIDATION HELPERS ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.email is string && data.email.size() <= 256 &&
        data.role in ['admin', 'operator', 'engineer'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'svgContent', 'widthMm', 'heightMm', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'ownerId', 'svgContent', 'widthMm', 'heightMm', 'cutLengthMm', 'engraveAreaCm2', 'materialCategory', 'recommendedThicknessMm', 'source', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.svgContent is string && data.svgContent.size() <= 500000 &&
        data.widthMm is number && data.widthMm > 0 &&
        data.heightMm is number && data.heightMm > 0 &&
        (!('cutLengthMm' in data) || (data.cutLengthMm is number && data.cutLengthMm >= 0)) &&
        (!('engraveAreaCm2' in data) || (data.engraveAreaCm2 is number && data.engraveAreaCm2 >= 0)) &&
        (!('materialCategory' in data) || (data.materialCategory is string && data.materialCategory.size() <= 64)) &&
        (!('recommendedThicknessMm' in data) || (data.recommendedThicknessMm is number && data.recommendedThicknessMm >= 0)) &&
        (!('source' in data) || (data.source in ['ai_prompt', 'image_trace', 'parametric_box', 'catalog']));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'ownerId', 'sku', 'productName', 'quantityRequested', 'status', 'priority', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'orderNumber', 'ownerId', 'sku', 'productName', 'quantityRequested', 'quantityIdealCalculated', 'status', 'priority', 'machineId', 'materialName', 'laserTimeEstimatedMin', 'scannedQuantity', 'dueDate', 'assignedTo', 'notes', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.orderNumber is string && data.orderNumber.size() <= 32 &&
        data.sku is string && data.sku.size() <= 64 &&
        data.productName is string && data.productName.size() <= 128 &&
        data.quantityRequested is number && data.quantityRequested > 0 &&
        data.status in ['Aguardando Corte', 'Cortando na Laser', 'Acabamento/Pintura', 'Montagem', 'Pronto/Embalado'] &&
        data.priority in ['Baixa', 'Normal', 'Alta', 'Urgente'] &&
        (!('quantityIdealCalculated' in data) || (data.quantityIdealCalculated is number && data.quantityIdealCalculated >= 0)) &&
        (!('machineId' in data) || (data.machineId is string && data.machineId.size() <= 64)) &&
        (!('materialName' in data) || (data.materialName is string && data.materialName.size() <= 64)) &&
        (!('laserTimeEstimatedMin' in data) || (data.laserTimeEstimatedMin is number && data.laserTimeEstimatedMin >= 0)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 32)) &&
        (!('assignedTo' in data) || (data.assignedTo is string && data.assignedTo.size() <= 128)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('scannedQuantity' in data) || (data.scannedQuantity is number && data.scannedQuantity >= 0 && data.scannedQuantity <= data.quantityRequested));
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'category', 'thickness_mm', 'sheetWidth_mm', 'sheetLength_mm', 'unitCost', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'category', 'thickness_mm', 'sheetWidth_mm', 'sheetLength_mm', 'unitCost', 'shippingCost', 'lossPercentage', 'density_kg_m3', 'speedsByMachine', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.category in ['MDF', 'Acrílico', 'Compensado', 'Madeira Maciça', 'EVA', 'Papelão', 'Couro'] &&
        data.thickness_mm is number && data.thickness_mm > 0 &&
        data.sheetWidth_mm is number && data.sheetWidth_mm > 0 &&
        data.sheetLength_mm is number && data.sheetLength_mm > 0 &&
        data.unitCost is number && data.unitCost >= 0 &&
        (!('shippingCost' in data) || (data.shippingCost is number && data.shippingCost >= 0)) &&
        (!('lossPercentage' in data) || (data.lossPercentage is number && data.lossPercentage >= 0)) &&
        (!('speedsByMachine' in data) || (data.speedsByMachine is list && data.speedsByMachine.size() <= 100)) &&
        (!('density_kg_m3' in data) || (data.density_kg_m3 is number && data.density_kg_m3 >= 0));
    }

    function isValidQuote(data) {
      return data.keys().hasAll(['id', 'ownerId', 'quoteNumber', 'customerName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'quoteNumber', 'customerName', 'customerPhone', 'customerEmail', 'customerDoc', 'total', 'status', 'validUntil', 'notes', 'items', 'desiredProfitMarginPct', 'extraTaxPct', 'fixedExtraFee', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.quoteNumber is string && data.quoteNumber.size() <= 32 &&
        data.customerName is string && data.customerName.size() <= 128 &&
        data.status in ['Rascunho', 'Enviado', 'Aprovado', 'Recusado', 'Convertido em Pedido'] &&
        (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 32)) &&
        (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 256)) &&
        (!('customerDoc' in data) || (data.customerDoc is string && data.customerDoc.size() <= 32)) &&
        (!('items' in data) || (data.items is list && data.items.size() <= 100)) &&
        (!('desiredProfitMarginPct' in data) || (data.desiredProfitMarginPct is number && data.desiredProfitMarginPct >= 0 && data.desiredProfitMarginPct < 100)) &&
        (!('extraTaxPct' in data) || (data.extraTaxPct is number && data.extraTaxPct >= 0 && data.extraTaxPct < 100)) &&
        (!('fixedExtraFee' in data) || (data.fixedExtraFee is number && data.fixedExtraFee >= 0)) &&
        (!('total' in data) || (data.total is number && data.total >= 0)) &&
        (!('validUntil' in data) || (data.validUntil is string && data.validUntil.size() <= 32)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['id', 'ownerId', 'tradeName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'tradeName', 'name', 'ie', 'address', 'cep', 'phone', 'email', 'cnpj', 'city', 'uf', 'cemigRateKwh', 'monthlyWorkHours', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.tradeName is string && data.tradeName.size() > 0 && data.tradeName.size() <= 128 &&
        (!('cnpj' in data) || (data.cnpj is string && data.cnpj.size() <= 32)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 64)) &&
        (!('uf' in data) || (data.uf is string && data.uf.size() <= 2)) &&
        (!('cemigRateKwh' in data) || (data.cemigRateKwh is number && data.cemigRateKwh >= 0)) &&
        (!('monthlyWorkHours' in data) || (data.monthlyWorkHours is number && data.monthlyWorkHours >= 0));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'ownerId', 'sku', 'name', 'category', 'physicalStock', 'unitPrice', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'sku', 'name', 'category', 'physicalStock', 'committedStock', 'minStock', 'idealStock', 'inProductionStock', 'minBatchToProduce', 'batchMultiple', 'unitPrice', 'costPrice', 'materialId', 'estimatedLaserTimeSeconds', 'dimensions_mm', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 64 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.category is string && data.category.size() <= 64 &&
        data.physicalStock is number && data.physicalStock >= 0 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        (!('committedStock' in data) || (data.committedStock is number && data.committedStock >= 0)) &&
        (!('minStock' in data) || (data.minStock is number && data.minStock >= 0)) &&
        (!('idealStock' in data) || (data.idealStock is number && data.idealStock >= 0)) &&
        (!('inProductionStock' in data) || (data.inProductionStock is number && data.inProductionStock >= 0)) &&
        (!('minBatchToProduce' in data) || (data.minBatchToProduce is number && data.minBatchToProduce >= 0)) &&
        (!('batchMultiple' in data) || (data.batchMultiple is number && data.batchMultiple >= 0)) &&
        (!('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0)) &&
        (!('materialId' in data) || (data.materialId is string && data.materialId.size() <= 64)) &&
        (!('estimatedLaserTimeSeconds' in data) || (data.estimatedLaserTimeSeconds is number && data.estimatedLaserTimeSeconds >= 0)) &&
        (!('dimensions_mm' in data) || data.dimensions_mm is map);
    }

    function isValidSalesOrder(data) {
      return data.keys().hasAll(['id', 'ownerId', 'orderNumber', 'channel', 'customerName', 'total', 'items', 'paymentStatus', 'fulfillmentStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'orderNumber', 'sourceQuoteId', 'channel', 'customerName', 'customerDoc', 'customerCity', 'customerUf', 'items', 'subtotal', 'shippingCost', 'discount', 'total', 'paymentMethod', 'paymentStatus', 'paidAt', 'fulfillmentStatus', 'invoiceKey', 'trackingCode', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 32 &&
        data.channel in ['Loja Própria', 'WhatsApp', 'Mercado Livre', 'Shopee', 'Temu', 'Balcão/Direto', 'Bling'] &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 128 &&
        data.total is number && data.total >= 0 &&
        data.items is list && data.items.size() <= 100 &&
        data.paymentStatus in ['Pago', 'Pendente', 'Cancelado'] &&
        data.fulfillmentStatus in ['Pendente', 'Em Produção', 'Separado', 'Nota Emitida', 'Enviado', 'Entregue'] &&
        (!('sourceQuoteId' in data) || (data.sourceQuoteId is string && data.sourceQuoteId.size() <= 64)) &&
        (!('customerDoc' in data) || (data.customerDoc is string && data.customerDoc.size() <= 32)) &&
        (!('customerCity' in data) || (data.customerCity is string && data.customerCity.size() <= 64)) &&
        (!('customerUf' in data) || (data.customerUf is string && data.customerUf.size() <= 2)) &&
        (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0)) &&
        (!('shippingCost' in data) || (data.shippingCost is number && data.shippingCost >= 0)) &&
        (!('discount' in data) || (data.discount is number && data.discount >= 0)) &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 32)) &&
        (!('paidAt' in data) || (data.paidAt is string && data.paidAt.size() <= 32)) &&
        (!('invoiceKey' in data) || (data.invoiceKey is string && data.invoiceKey.size() <= 48)) &&
        (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 64));
    }

    function isValidMachine(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'type', 'laserPowerW', 'workAreaX_mm', 'workAreaY_mm', 'purchasePrice', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'model', 'type', 'laserPowerW', 'workAreaX_mm', 'workAreaY_mm', 'purchasePrice', 'depreciationYears', 'monthlyWorkHours', 'energyConsumptionKwh', 'monthlyMaintenanceCosts', 'tubeSpareCost', 'notes', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.type in ['CO2', 'Diodo', 'Fibra', 'Router', 'Plasma', 'laser_co2', 'laser_fiber', 'cnc_router', 'plasma'] &&
        data.laserPowerW is number && data.laserPowerW >= 0 &&
        data.workAreaX_mm is number && data.workAreaX_mm > 0 &&
        data.workAreaY_mm is number && data.workAreaY_mm > 0 &&
        data.purchasePrice is number && data.purchasePrice >= 0 &&
        (!('model' in data) || (data.model is string && data.model.size() <= 128)) &&
        (!('depreciationYears' in data) || (data.depreciationYears is number && data.depreciationYears >= 0)) &&
        (!('monthlyWorkHours' in data) || (data.monthlyWorkHours is number && data.monthlyWorkHours >= 0)) &&
        (!('energyConsumptionKwh' in data) || (data.energyConsumptionKwh is number && data.energyConsumptionKwh >= 0)) &&
        (!('monthlyMaintenanceCosts' in data) || (data.monthlyMaintenanceCosts is number && data.monthlyMaintenanceCosts >= 0)) &&
        (!('tubeSpareCost' in data) || (data.tubeSpareCost is number && data.tubeSpareCost >= 0)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // --- COLLECTION RULES ---

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId &&
        isValidUser(incoming()) && incoming().id == userId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (incoming().role != 'admin' || isAdmin());
      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming()) &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']))
        );
      allow delete: if isAdmin();
    }

    // PROJECTS COLLECTION
    match /projects/{projectId} {
      allow get: if isVerified() && isValidId(projectId) && (!exists(/databases/$(database)/documents/projects/$(projectId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == projectId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(projectId) && isValidProject(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'svgContent', 'widthMm', 'heightMm', 'cutLengthMm', 'engraveAreaCm2', 'materialCategory', 'recommendedThicknessMm', 'source', 'updatedAt'
        ]));
      allow delete: if isVerified() && isValidId(projectId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ORDERS COLLECTION
    match /orders/{orderId} {
      allow get: if isVerified() && isValidId(orderId) && (!exists(/databases/$(database)/documents/orders/$(orderId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == orderId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orderId) && isValidOrder(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().status != 'Pronto/Embalado' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'priority', 'scannedQuantity', 'productName', 'quantityRequested', 'quantityIdealCalculated', 'machineId', 'materialName', 'laserTimeEstimatedMin', 'dueDate', 'assignedTo', 'notes', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified() && isValidId(orderId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // MATERIALS COLLECTION
    match /materials/{materialId} {
      allow get: if isVerified() && isValidId(materialId) && (!exists(/databases/$(database)/documents/materials/$(materialId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(materialId) && isValidMaterial(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == materialId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(materialId) && isValidMaterial(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'thickness_mm', 'sheetWidth_mm', 'sheetLength_mm', 'unitCost', 'shippingCost', 'lossPercentage', 'density_kg_m3', 'speedsByMachine', 'updatedAt'
        ]));
      allow delete: if isVerified() && isValidId(materialId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // QUOTES COLLECTION
    match /quotes/{quoteId} {
      allow get: if isVerified() && isValidId(quoteId) && (!exists(/databases/$(database)/documents/quotes/$(quoteId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(quoteId) && isValidQuote(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == quoteId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(quoteId) && isValidQuote(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().status != 'Convertido em Pedido' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'customerName', 'customerPhone', 'customerEmail', 'customerDoc', 'total', 'status', 'validUntil', 'notes', 'items', 'desiredProfitMarginPct', 'extraTaxPct', 'fixedExtraFee', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified() && isValidId(quoteId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // SETTINGS COLLECTION
    match /settings/{settingId} {
      allow get: if isVerified() && isValidId(settingId) && (!exists(/databases/$(database)/documents/settings/$(settingId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(settingId) && isValidSettings(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == settingId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(settingId) && isValidSettings(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'tradeName', 'name', 'ie', 'address', 'cep', 'phone', 'email', 'cnpj', 'city', 'uf', 'cemigRateKwh', 'monthlyWorkHours', 'updatedAt'
        ]));
      allow delete: if isVerified() && isValidId(settingId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow get: if isVerified() && isValidId(productId) && (!exists(/databases/$(database)/documents/products/$(productId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(productId) && isValidProduct(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == productId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(productId) && isValidProduct(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'physicalStock', 'committedStock', 'minStock', 'idealStock', 'inProductionStock', 'minBatchToProduce', 'batchMultiple', 'unitPrice', 'costPrice', 'materialId', 'estimatedLaserTimeSeconds', 'dimensions_mm', 'updatedAt'
        ]));
      allow delete: if isVerified() && isValidId(productId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // SALES ORDERS COLLECTION
    match /sales_orders/{salesOrderId} {
      allow get: if isVerified() && isValidId(salesOrderId) && (!exists(/databases/$(database)/documents/sales_orders/$(salesOrderId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(salesOrderId) && isValidSalesOrder(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == salesOrderId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(salesOrderId) && isValidSalesOrder(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'orderNumber', 'channel', 'customerName', 'customerDoc', 'customerCity', 'customerUf', 'items', 'subtotal', 'shippingCost', 'discount', 'total', 'paymentMethod', 'paymentStatus', 'paidAt', 'fulfillmentStatus', 'invoiceKey', 'trackingCode', 'updatedAt'
        ]));
      allow delete: if isVerified() && isValidId(salesOrderId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // MACHINES COLLECTION
    match /machines/{machineId} {
      allow get: if isVerified() && isValidId(machineId) && (!exists(/databases/$(database)/documents/machines/$(machineId)) || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(machineId) && isValidMachine(incoming()) &&
        incoming().ownerId == request.auth.uid && incoming().id == machineId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(machineId) && isValidMachine(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'model', 'type', 'laserPowerW', 'workAreaX_mm', 'workAreaY_mm', 'purchasePrice', 'depreciationYears', 'monthlyWorkHours', 'energyConsumptionKwh', 'monthlyMaintenanceCosts', 'tubeSpareCost', 'notes', 'updatedAt'
        ]));
      allow delete: if isVerified() && isValidId(machineId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
